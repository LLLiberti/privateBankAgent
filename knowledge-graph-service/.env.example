# Copy this file to .env and fill in environment-specific values.
# Never commit the populated .env file.

# MySQL (required for extraction and dependency health checks)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Neo4j (required for EXECUTE mode and dependency health checks)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECT_TIMEOUT_SECONDS=10
NEO4J_MAX_RETRIES=2


